# Copy this file to .env and add your keys.
#
# ANTHROPIC_API_KEY writes the doctors' replies (Claude Sonnet 5.5).
# OPENAI_API_KEY makes the doctors' voices (and can write the replies if there is no Anthropic key).
# The program reads .env by itself, so there is nothing else to run. Never commit .env.
#
# Get an Anthropic key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get an OpenAI key at https://platform.openai.com
OPENAI_API_KEY=
