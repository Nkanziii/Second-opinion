# Copy this file to .env and fill in ONE of the keys below, then
# `export $(cat .env | xargs)` before running (or use a tool like
# python-dotenv / direnv if you prefer).
#
# Get an Anthropic key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Or an OpenAI key at https://platform.openai.com
OPENAI_API_KEY=
